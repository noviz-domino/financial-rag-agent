# 이 파일을 복사해서 .env 로 이름을 바꾸고 값을 채우세요.
#   cp .env.example .env
# .env 는 .gitignore 에 들어 있어서 git 에 올라가지 않아요. 키는 절대 커밋하지 마세요.

# ── 필수 ───────────────────────────────────────────
# Gemini API 키 (답변·근거 판단·그림 설명·임베딩·채점에 사용)
# 발급: https://aistudio.google.com/apikey
GEMINI_API_KEY=여기에_본인_키

# ── 선택: LangSmith 추적 (회의에서 쓸지 결정 전, 기본은 꺼짐) ──
# 켜면 질문·근거·답변·토큰 사용량이 LangSmith 서버로 전송돼요. Gemini 키는 전송되지 않아요.
# 쓰기로 하면 아래 줄의 맨 앞 # 을 지우고 값을 채우세요. (아직 코드 연동은 안 되어 있어요)
# LANGSMITH_TRACING=true
# LANGSMITH_API_KEY=여기에_LangSmith_키
# LANGSMITH_PROJECT=financial-rag-agent
